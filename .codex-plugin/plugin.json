{
  "name": "whatsapp-tools",
  "version": "0.3.0",
  "description": "WhatsApp tools for coding agents: chats, contacts, history, received files, sends and actions.",
  "author": {
    "name": "craftsamo",
    "url": "https://github.com/craft-agent"
  },
  "homepage": "https://github.com/craft-agent/whatsapp-tools#readme",
  "repository": "https://github.com/craft-agent/whatsapp-tools",
  "license": "LicenseRef-AGPL-3.0-Commons-Clause",
  "skills": "./skills",
  "mcpServers": {
    "whatsapp-tools": {
      "command": "node",
      "args": ["dist/mcp.js"],
      "cwd": ".",
      "default_tools_approval_mode": "writes",
      "env_vars": [
        "WHATSAPP_TOOLS_TOOLSETS",
        "WHATSAPP_TOOLS_READ_ONLY",
        "WHATSAPP_TOOLS_TOOLS",
        "WHATSAPP_TOOLS_EXCLUDE_TOOLS",
        "WHATSAPP_TOOLS_CONFIRM",
        "WHATSAPP_TOOLS_UNATTENDED",
        "WHATSAPP_TOOLS_GRANTS_DIR",
        "WHATSAPP_TOOLS_STATE_DIR",
        "WHATSAPP_TOOLS_DOWNLOAD_DIR",
        "WHATSAPP_TOOLS_SEND_DIRS",
        "WHATSAPP_TOOLS_EXCLUDE_CHATS",
        "WHATSAPP_TOOLS_GRANT_KEY"
      ],
      "tool_timeout_sec": 330
    }
  }
}
